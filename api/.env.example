# Local development needs no configuration. Production: set HTTPS, SMTP and permissions.
APP_URL=http://localhost:8765
DB_DRIVER=sqlite
# Leave empty for api/storage/konta.sqlite. For MySQL, set a database name.
DB_DATABASE=
DB_HOST=localhost
DB_USERNAME=konta
DB_PASSWORD=
# file writes private .eml files to storage/mail; smtp delivers real email.
MAIL_TRANSPORT=file
MAIL_FROM=konta@localhost
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
# Optional. Households must explicitly enable AI before any request is sent.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# APNs .p8 key lives outside webroot and outside version control.
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=de.groon.konta
