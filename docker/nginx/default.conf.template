upstream backend_upstream {
    server backend:8000;
}

upstream frontend_upstream {
    server frontend:3000;
}

upstream minio_upstream {
    server minio:9000;
}

server {
    listen 80;
    server_name _;

    client_max_body_size 64M;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # --- Django REST API -----------------------------------------------------
    location /api/ {
        proxy_pass http://backend_upstream;
        proxy_read_timeout 120s;
    }

    # --- Django admin --------------------------------------------------------
    location /admin/ {
        proxy_pass http://backend_upstream;
    }

    # --- WebSockets (channels) ----------------------------------------------
    location /ws/ {
        proxy_pass http://backend_upstream;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # --- Uploaded files (MinIO S3 API) --------------------------------------
    # Presigned URLs are signed for the internal host, so we must forward that
    # exact Host header – otherwise every signature check fails.
    location /s3/ {
        rewrite ^/s3/(.*)$ /$1 break;
        proxy_pass http://minio_upstream;
        proxy_set_header Host minio:9000;
        proxy_buffering off;
        chunked_transfer_encoding off;
    }

    # --- Collected Django static files (admin, DRF browsable API) -----------
    location /static/ {
        alias /srv/static/;
        access_log off;
        expires 7d;
    }

    # --- Next.js frontend ----------------------------------------------------
    location / {
        proxy_pass http://frontend_upstream;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
