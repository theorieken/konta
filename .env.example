# =============================================================================
# Haushalts-Finanzplanung – Environment
# =============================================================================
# Copy this file to `.env` and adjust what you need. EVERY value has a working
# default, so `bash deploy.sh` works without any manual editing. The defaults
# target a local single-host installation on http://localhost:8080.
# =============================================================================

# --- General -----------------------------------------------------------------
COMPOSE_PROJECT_NAME=finplan
# Public domain (no scheme). Used for ALLOWED_HOSTS / CSRF / CORS.
DOMAIN=localhost
# Public scheme: http or https
SCHEME=http
# Public port that nginx binds on the host.
PORT=8080
# Django DEBUG. Keep 0 for anything that is not your laptop.
DEBUG=1
# Comma separated extra hosts, e.g. "192.168.1.50,finanzen.local"
EXTRA_ALLOWED_HOSTS=

# --- Security ----------------------------------------------------------------
# deploy.sh replaces the CHANGE_ME values with generated secrets on first run.
DJANGO_SECRET_KEY=CHANGE_ME_django_secret
SECURITY_SALT=CHANGE_ME_security_salt
# Lifetime of an auth token in days. 0 = never expires.
AUTH_TOKEN_TTL_DAYS=30
# Lifetime of invitation and password-reset links in hours.
PASSWORD_LINK_TTL_HOURS=24

# --- E-mail ------------------------------------------------------------------
# These values can also be changed later under Einstellungen → E-Mail.
# With an empty host, local DEBUG installations print messages to backend logs.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=finanzplanung@localhost

# --- Database (PostgreSQL) ---------------------------------------------------
POSTGRES_DB=finplan
POSTGRES_USER=finplan
POSTGRES_PASSWORD=finplan_dev_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis (channel layer + celery broker + cache) ---------------------------
REDIS_HOST=redis
REDIS_PORT=6379

# --- MinIO (S3 compatible object storage for uploaded files) -----------------
MINIO_ROOT_USER=finplan
MINIO_ROOT_PASSWORD=finplan_dev_password
MINIO_BUCKET=finplan-files
MINIO_ENDPOINT=http://minio:9000
# Endpoint the browser uses for presigned download URLs. Leave empty to serve
# them through this app's own nginx (${SCHEME}://${DOMAIN}:${PORT}/s3), which
# means MinIO needs no host port of its own.
MINIO_PUBLIC_ENDPOINT=

# --- Bootstrap admin ---------------------------------------------------------
# Created on first boot when the database is still empty. Leave the password
# empty to skip auto-creation and use the /onboarding page in the UI instead.
BOOTSTRAP_ADMIN_EMAIL=admin@localhost
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=Administrator

# --- OpenAI (transaction classification) -------------------------------------
# Can also be set later in the UI under Einstellungen. The database value wins.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Override for OpenAI compatible gateways (Azure, LiteLLM, Ollama, ...).
OPENAI_BASE_URL=
# Transactions per classification request.
OPENAI_BATCH_SIZE=25

# --- Planning defaults -------------------------------------------------------
# How many months into the future planned transactions are materialised.
PREDICTION_HORIZON_MONTHS=24
DEFAULT_CURRENCY=EUR
TIME_ZONE=Europe/Berlin
LANGUAGE_CODE=de-de

# --- Frontend ----------------------------------------------------------------
# Same-origin by default: nginx proxies /api and /ws to the backend.
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_WS_URL=/ws
NEXT_PUBLIC_APP_NAME=Finanzplanung
